{
  "name": "dukaanpay-ai",
  "version": "1.0.0",
  "private": true,
  "description": "DukaanPayAI – Autonomous Merchant Growth Platform",
  "workspaces": [
    "packages/*",
    "services/api-gateway",
    "services/merchant-service",
    "services/transaction-service",
    "services/inventory-service",
    "services/health-score-service",
    "services/campaign-service",
    "services/notification-service"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/api/docs && cp src/api/docs/openapi.yaml dist/api/docs/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "ts-node src/tests/backend.test.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/yamljs": "^0.2.34",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "paytm",
    "ai",
    "kirana",
    "langgraph",
    "microservices",
    "fintech"
  ],
  "author": "Team Sentinels (Akshat Arya & Mayank Yadav)",
  "license": "MIT",
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.3.7",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.1.1",
    "uuid": "^14.0.2",
    "yamljs": "^0.3.0",
    "zod": "^4.6.5"
  }
}
