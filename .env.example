# ====================================================================
# DukaanPayAI – Clean Architecture Core Backend Platform Environment
# ====================================================================

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Primary Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dukaanpay_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_READ_REPLICA_URL=postgresql://postgres:postgres@localhost:5433/dukaanpay_db_replica

# Caching & Distributed Synchronization (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_CACHE_DEFAULT_TTL=3600

# Event Streaming (Apache Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dukaanpay-backend
KAFKA_GROUP_ID=dukaanpay-core-group

# Authentication & JWT
JWT_SECRET=dukaanpay-enterprise-jwt-secret-key-min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dukaanpay-enterprise-refresh-secret-key-min32
JWT_REFRESH_EXPIRES_IN=7d

# Telecom Integration (Twilio WhatsApp & Voice)
# Add your real production Twilio credentials below
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_secret_placeholder
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+12025550143

# Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=dukaanpay-assets
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local Zero-Dependency Execution (set to false when running in Docker with real DB/Redis/Kafka)
USE_IN_MEMORY_DB=true
USE_EMBEDDED_BUS=true
